{
  "manifest_version": 3,
  "name": "Drift Audio",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Shape tab audio with speed, pitch, spacious reverb, bass and personal presets. Processing stays on your device.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "panel.html", "default_title": "Drift Audio" },
  "icons": { "16": "art/icon16.png", "48": "art/icon48.png", "128": "art/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["media.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
